from fastapi import FastAPI

app = FastAPI(
    title="Enterprise Analytics Platform",
    version="1.0.0",
)


@app.get("/health")
def health_check():
    return {
        "status": "healthy",
        "message": "Enterprise Analytics backend is running",
    }


@app.get("/")
def root():
    return {
        "message": "Enterprise Analytics API",
    }
